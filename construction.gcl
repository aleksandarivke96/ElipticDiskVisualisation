% --------------------------------------------------------------------
% Elliptic geometry, closed disk model
%
% Written for GCLC, Predrag Janicic, University of Belgrade:
%     gclc  thisfile.gcl        -> LaTeX picture
%     gclc -svg thisfile.gcl    -> SVG
%
% The elliptic plane is the sphere with antipodal points identified;
% its upper half projects onto the closed unit disk, so opposite
% points of the boundary circle are one and the same point.  A line
% is a great circle, and a great circle projects to an ellipse about
% the centre with semi-axes 1 and |n_z| - so each line below is half
% an ellipse, drawn as one arc rather than sampled.
%
% View: stereographic - from the south pole; a line is a circular arc, angles are true.
% Coordinates are the construction's own: the unit disk sits at
% radius 43mm about (50, 50), which is what ang_origin and ang_unit say.
% Drawn plain: no colour, and the rest of each line dashed.
% 3 points, 4 lines, 1 triangles
% --------------------------------------------------------------------

dim 100 100

ang_picture 0 0 100 100
ang_origin 50 50
ang_unit 43

% the disk; opposite boundary points are the same point
linethickness 0.50
ang_point Ocentre 0.00000 0.00000
ang_point Orim 1.00000 0.00000
drawdashcircle Ocentre Orim

% line a through A and B, an arc of a circle of radius 1.1818
ang_point aC -0.49422 0.39023
ang_point aX 0.68753 0.39023
ang_point aY -0.49422 1.57198
linethickness 0.50
drawellipsearc2 aC aX aY 263.9046 115.6019

% segment b = CB, length 1.1769 rad, an arc of a circle of radius 1.5208
ang_point bC -0.37442 -1.08291
ang_point bX 1.14640 -1.08291
ang_point bY -0.37442 0.43791
linethickness 0.25
drawdashellipsearc2 bC bX bY 29.8143 82.2253
linethickness 0.90
drawellipsearc2 bC bX bY 93.6289 18.4107
drawellipsearc2 bC bX bY 29.8143 18.4460

% segment c = BA, length 1.3995 rad, an arc of a circle of radius 1.1818
ang_point cC -0.49422 0.39023
ang_point cX 0.68753 0.39023
ang_point cY -0.49422 1.57198
linethickness 0.25
drawdashellipsearc2 cC cX cY 263.9046 115.6019
linethickness 0.90
drawellipsearc2 cC cX cY 297.7987 45.5642

% segment d = AC, length 1.1024 rad, an arc of a circle of radius 1.5894
ang_point dC 1.11583 0.53009
ang_point dX 2.70519 0.53009
ang_point dY 1.11583 2.11946
linethickness 0.25
drawdashellipsearc2 dC dX dY 166.4210 77.9797
linethickness 0.90
drawellipsearc2 dC dX dY 228.2214 16.1793
drawellipsearc2 dC dX dY 166.4210 17.0142

% triangle CBA: angles 90.19 64.90 69.58 deg, sum 224.67 deg, area 0.7796 = the excess over pi (Girard)
linethickness 0.30
ang_point CBACaC -0.47350 0.43746
ang_point CBACaX -0.38152 0.43746
ang_point CBACaY -0.47350 0.52944
drawellipsearc2 CBACaC CBACaX CBACaY 90.0235 97.1660
ang_point CBABaC 0.64188 0.05220
ang_point CBABaX 0.73380 0.05220
ang_point CBABaY 0.64188 0.14413
drawellipsearc2 CBABaC CBABaX CBABaY 248.9821 65.7197
ang_point CBAAaC 0.05726 -0.65912
ang_point CBAAaX 0.15067 -0.65912
ang_point CBAAaY 0.05726 -0.56571
drawellipsearc2 CBAAaC CBAAaX CBAAaY 321.6898 70.5535

% the points, with their labels
linethickness 0.50
ang_point A 0.05691 -0.65513
cmark_rb A
ang_point B 0.63806 0.05189
cmark_rt B
ang_point C -0.47068 0.43486
cmark_lt C
